# ============================================================================
# Personal Financial & Global Intelligence Telegram Bot - configuration
# ============================================================================
# Copy to .env and fill in. Never commit the real .env.
#
#   cp .env.example .env && chmod 600 .env
#
# Every variable below is declared in config.py. Unknown variables in .env are
# rejected, so a typo fails loudly at startup instead of silently disabling a
# section.
#
# Boolean syntax: true/false, 1/0, yes/no, on/off (case-insensitive).
# Duration syntax for *_TIMEOUT and CACHE_TTL: integer seconds.


# ----------------------------------------------------------------------------
# 1. Telegram - REQUIRED
# ----------------------------------------------------------------------------
# Token from @BotFather (/newbot or /token). Format: 1234567890:AA...
# The bot refuses to start if this is missing or still holds the placeholder.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_12345678

# Your numeric user id. ONLY this id may talk to the bot; every other sender,
# every group and every channel is ignored. Get yours from @userinfobot.
# It is a number, not a @username.
TELEGRAM_USER_ID=987654321

# Optional: a second id for a spouse/device. Leave empty to disable.
# Still an allow-list entry, never a wildcard.
TELEGRAM_EXTRA_USER_ID=


# ----------------------------------------------------------------------------
# 2. Scheduling - REQUIRED defaults shown
# ----------------------------------------------------------------------------
# 24h local wall-clock time. America/Toronto DST transitions are handled by
# zoneinfo, so 09:00 stays 09:00 local year-round.
DELIVERY_TIME=09:00

# IANA name, not an abbreviation. Montreal is America/Toronto.
TIMEZONE=America/Toronto

# 0=Sunday .. 6=Saturday, as JSON array. e.g. "[0,1,2,3,4,5,6]" for all days
DELIVERY_DAYS=[0,1,2,3,4,5,6]


# ----------------------------------------------------------------------------
# 3. Location (weather) - REQUIRED defaults shown
# ----------------------------------------------------------------------------
WEATHER_LATITUDE=45.5017
WEATHER_LONGITUDE=-73.5673
WEATHER_CITY=Montreal
WEATHER_COUNTRY=Canada


# ----------------------------------------------------------------------------
# 4. Optional API keys
# ----------------------------------------------------------------------------
# The bot is fully functional with NONE of these set. Each block below says
# what it unlocks and what the bot does without it. Blank == feature disabled,
# and the affected section reports "unavailable - optional key not configured"
# rather than guessing or failing.
#
# None of these registrations require a credit card.

# FRED - St. Louis Fed. Official US CPI, PCE, nonfarm payrolls, GDP, and the
# 2Y/5Y/10Y Treasury constant-maturity yields.
# Register: https://fredaccount.stlouisfed.org/apikeys
# Free limit: 120 requests/minute.
# Without it: US bond yields and macro series fall back to Yahoo Finance
#   quotes (delayed, less precise) and the values are labelled accordingly.
FRED_API_KEY=

# CoinGecko Demo key - raises crypto rate limits and unlocks market cap and
# volume fields reliably for BTC/ETH/SOL.
# Register: https://www.coingecko.com/en/api
# Free limit: ~30 calls/minute with a Demo key; the keyless public endpoint
#   works too but is throttled harder.
# Without it: public endpoint is used. Still free, still works.
COINGECKO_API_KEY=

# Finnhub - backup quotes for stock indices when the primary source fails.
# Register: https://finnhub.io/register
# Free limit: 60 calls/minute, commercial use not permitted on free tier.
# Without it: single source for indices. Enable only if you see gaps.
FINNHUB_API_KEY=

# Alpha Vantage - LAST RESORT ONLY. Its free tier is roughly 25 requests/day,
# which one daily briefing can exhaust. Leave empty unless you specifically
# want it as a third fallback, and the bot will not call it unless the two
# primary sources both failed today.
# Register: https://www.alphavantage.co/support/#api-key
# Free limit: 25 requests/day, 5/minute.
ALPHA_VANTAGE_API_KEY=


# ----------------------------------------------------------------------------
# 5. Network - defaults shown, tune only if needed
# ----------------------------------------------------------------------------
# Per-request timeout in seconds. Oracle VPS outbound is fine at 15.
REQUEST_TIMEOUT=15

# Bounded retries per request. Retries use exponential backoff.
MAX_RETRIES=2

# Base backoff in seconds: attempt n waits RETRY_BACKOFF * 2**(n-1), capped at
# 30s. A 429 response honours Retry-After when the provider sends one.
RETRY_BACKOFF=2.0

# Maximum simultaneous outbound requests across the whole bot. Keep this low:
# it is what protects free quotas during the 09:00 briefing fan-out.
MAX_CONCURRENCY=4

# Default cache TTL in seconds for sources without an explicit rule.
# Per-source TTLs (weather, crypto, indices, yields, policy rates, RSS) are
# derived in config.py from provider update frequency, not from this value.
CACHE_TTL=900


# ----------------------------------------------------------------------------
# 6. Report sections - toggle any section off
# ----------------------------------------------------------------------------
# Turning a section off also stops its API calls, so disabling ENABLE_CRYPTO
# genuinely saves quota. All on by default.

# Markets
ENABLE_OIL=true
ENABLE_CRYPTO=true
ENABLE_STOCKS=true
ENABLE_BONDS=true
ENABLE_RATES=true
ENABLE_FOREX=true

# Macro and news
ENABLE_ECONOMIC=true
ENABLE_NEWS=true
ENABLE_CALENDAR=true
ENABLE_WEATHER=true

# Country blocks
ENABLE_CANADA=true
ENABLE_US=true
ENABLE_MOROCCO=true
ENABLE_EUROPE=true


# ----------------------------------------------------------------------------
# 7. Canadian mortgage and savings detail
# ----------------------------------------------------------------------------
# Commercial lender offers (fixed/variable mortgage, HISA, GIC) have no free
# official API. When true, the bot reports the official anchors only - BoC
# policy rate, BoC prime rate, and the 2Y/5Y Government of Canada yields - and
# states plainly that lender-specific rates are unavailable from a free
# source. When false, the whole section is skipped.
#
# The bot never fabricates a bank offer regardless of this setting.
ENABLE_CA_MORTGAGE=true


# ----------------------------------------------------------------------------
# 8. Local state - the only persistence in the project
# ----------------------------------------------------------------------------
# Directory for the delivery-marker file that prevents a duplicate 07:00
# briefing after a systemd restart on the same day. Relative paths resolve
# against the project root. No database, nothing else is written here.
STATE_DIR=state


# ----------------------------------------------------------------------------
# 9. Logging
# ----------------------------------------------------------------------------
# DEBUG / INFO / WARNING / ERROR. Logs go to stdout and are captured by
# journald. Credentials and full API keys are never logged at any level.
LOG_LEVEL=INFO
